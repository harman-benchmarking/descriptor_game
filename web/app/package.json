{
  "name": "descriptor-card-game",
  "version": "0.1.0",
  "description": "Desktop package for the Descriptor Game web app.",
  "author": "Descriptor Game",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "sync:detail-doc": "node ../tools/node/sync-detail-doc.mjs",
    "sync:assets": "node ../tools/node/sync-assets.mjs",
    "sync:shared": "npm run sync:detail-doc && npm run sync:assets",
    "predev": "npm run sync:shared",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run sync:shared",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "jsdom": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "build": {
    "appId": "com.descriptor.game",
    "productName": "Descriptor Game",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Descriptor Game"
    }
  }
}
